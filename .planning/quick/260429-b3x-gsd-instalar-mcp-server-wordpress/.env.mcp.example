# Variaveis de ambiente para scripts de validacao MCP — Jurema Brokers WordPress
#
# Instrucoes:
#   1. Copie este arquivo: cp .env.mcp.example .env.mcp
#   2. Edite .env.mcp e substitua os valores abaixo pelos valores reais
#   3. NUNCA commite o arquivo .env.mcp — ele esta no .gitignore
#
# Onde obter WP_APP_PASSWORD:
#   WP Admin > Usuarios > Editar mcp-bot > Application Passwords
#   Gerar nova com o nome "mcp-server-claude"
#   Copiar o token exibido (formato: xxxx xxxx xxxx xxxx xxxx xxxx)
#
# Referencia:
#   https://make.wordpress.org/core/2020/11/05/application-passwords-integration-guide/

# URL base do WordPress (sem barra no final)
WP_URL=https://juremabksimoveis.com.br

# Nome de usuario MCP dedicado (criado conforme INSTALL-WP-ADMIN.md Parte 2)
WP_USER=mcp-bot

# Application Password gerada em WP Admin > Usuarios > mcp-bot > Application Passwords
# Pode incluir espacos (os scripts normalizam automaticamente)
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

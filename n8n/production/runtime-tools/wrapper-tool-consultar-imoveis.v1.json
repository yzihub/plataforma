      "parameters": {
        "jsCode": "// Validate auth + payload. Fail-closed: any missing/invalid input throws.\nconst started = Date.now();\nconst item = $input.first().json;\nconst body = item.body || item;\nconst headers = item.headers || {};\n\nconst expected = (\n  $vars.JUREMA_TOOL_WEBHOOK_SECRET ||\n  $vars.RUNTIME_COGNITIVE_WEBHOOK_SECRET ||\n  $vars.EVOLUTION_WEBHOOK_SECRET ||\n  $env.JUREMA_TOOL_WEBHOOK_SECRET ||\n  $env.RUNTIME_COGNITIVE_WEBHOOK_SECRET ||\n  $env.EVOLUTION_WEBHOOK_SECRET ||\n  ''\n).trim();\nif (!expected) {\n  throw new Error('wrapper config error: JUREMA_TOOL_WEBHOOK_SECRET nao configurado em n8n');\n}\n\nconst provided = (\n  headers['x-n8n-api-key'] ||\n  headers['X-N8N-API-KEY'] ||\n  headers['x-webhook-secret'] ||\n  headers['X-Webhook-Secret'] ||\n  ''\n).toString().trim();\n\nif (provided !== expected) {\n  throw new Error('unauthorized: x-n8n-api-key ausente ou invalido');\n}\n\nconst clean = (v) => String(v ?? '').trim();\nconst tenant_id = clean(body.tenant_id);\nconst phone = clean(body.phone || body.telefoneCompleto);\n\nif (!tenant_id) throw new Error('payload invalido: tenant_id ausente');\nif (!phone) throw new Error('payload invalido: phone ausente');\n\nreturn [{\n  json: {\n    __started_at: started,\n    tenant_id,\n    phone,\n    codigo_ref: clean(body.codigo_ref),\n    bairro: clean(body.bairro || body.location_preference),\n    tipo_imovel: clean(body.tipo_imovel || body.property_type),\n    quartos: clean(body.quartos || body.bedrooms),\n    valor_max: clean(body.valor_max || body.budget_max)\n  }\n}];"
      },

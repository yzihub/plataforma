      "parameters": {
        "jsCode": "// Format inner tool output into runtime contract.\nconst started = $('Validate Auth + Payload').first().json.__started_at;\nconst inner = $input.first().json || {};\nconst cards = Array.isArray(inner.cards) ? inner.cards : [];\n\nreturn [{\n  json: {\n    ok: true,\n    tool: 'consultar_imoveis',\n    latency_ms: Date.now() - started,\n    output: {\n      success: inner.success !== false,\n      total: inner.total ?? cards.length,\n      total_received: inner.total_received ?? null,\n      total_filtered: inner.total_filtered ?? null,\n      total_ranked: inner.total_ranked ?? null,\n      payload_policy: inner.payload_policy || 'ju_minimal_operational_cards_v1',\n      filters_used: inner.filters_used || null,\n      ranking_profile: inner.ranking_profile || null,\n      cards,\n      warning: inner.warning || null,\n      fallback_message: inner.fallback_message || null\n    }\n  }\n}];"
      },

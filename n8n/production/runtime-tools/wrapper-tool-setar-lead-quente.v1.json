      "parameters": {
        "jsCode": "// Validate auth + payload. Fail-closed.\nconst started = Date.now();\nconst item = $input.first().json;\nconst body = item.body || item;\nconst headers = item.headers || {};\n\nconst expected = (\n  $vars.JUREMA_TOOL_WEBHOOK_SECRET ||\n  $vars.RUNTIME_COGNITIVE_WEBHOOK_SECRET ||\n  $vars.EVOLUTION_WEBHOOK_SECRET ||\n  $env.JUREMA_TOOL_WEBHOOK_SECRET ||\n  $env.RUNTIME_COGNITIVE_WEBHOOK_SECRET ||\n  $env.EVOLUTION_WEBHOOK_SECRET ||\n  ''\n).trim();\nif (!expected) {\n  throw new Error('wrapper config error: JUREMA_TOOL_WEBHOOK_SECRET nao configurado em n8n');\n}\n\nconst provided = (\n  headers['x-n8n-api-key'] ||\n  headers['X-N8N-API-KEY'] ||\n  headers['x-webhook-secret'] ||\n  headers['X-Webhook-Secret'] ||\n  ''\n).toString().trim();\n\nif (provided !== expected) {\n  throw new Error('unauthorized: x-n8n-api-key ausente ou invalido');\n}\n\nconst clean = (v) => String(v ?? '').trim();\nconst tenant_id = clean(body.tenant_id);\nconst phone = clean(body.phone || body.telefoneCompleto);\nconst lead_id = clean(body.lead_id);\nconst deal_id = clean(body.deal_id);\n\nif (!tenant_id) throw new Error('payload invalido: tenant_id ausente');\nif (!phone) throw new Error('payload invalido: phone ausente');\nif (!lead_id && !deal_id) throw new Error('payload invalido: lead_id ou deal_id obrigatorio');\n\nreturn [{\n  json: {\n    __started_at: started,\n    tenant_id,\n    phone,\n    lead_id,\n    deal_id,\n    motivo: clean(body.motivo) || 'visit_or_coffee_acceptance',\n    localizacao_visita: clean(body.localizacao_visita),\n    observacao: clean(body.observacao)\n  }\n}];"
      },

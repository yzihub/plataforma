      "id": "7d9a8e2c-2a38-4c6f-91c1-2e9f0f9c1b01",
      "name": "Webhook Enviar Contrato",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        320
      ],
      "webhookId": "236eec66-ddc5-4414-a652-acacf7a4b508"
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body ?? $json;\nconst tenant_id = body.tenant_id ?? null;\nconst contract_id = body.contract_id ?? null;\nconst lead_id = body.lead_id ?? null;\nconst canais = body.canais ?? { whatsapp: true, email: true };\nconst conteudo = typeof body.conteudo === 'string' ? body.conteudo.trim() : '';\n\nconst missing = [];\nif (!tenant_id) missing.push('tenant_id');\nif (!contract_id) missing.push('contract_id');\nif (!lead_id) missing.push('lead_id');\nif (!conteudo) missing.push('conteudo');\n\nif (missing.length > 0) {\n  throw new Error(`Payload invalido. Campos obrigatorios ausentes ou vazios: ${missing.join(', ')}`);\n}\n\nconst supabaseUrl = $vars.SUPABASE_URL ?? $vars.NEXT_PUBLIC_SUPABASE_URL;\nconst serviceRole = $vars.SUPABASE_SERVICE_ROLE_KEY;\n\nif (!supabaseUrl) throw new Error('SUPABASE_URL nao configurada');\nif (!serviceRole) throw new Error('SUPABASE_SERVICE_ROLE_KEY nao configurada');\n\nreturn [{\n  json: {\n    tenant_id,\n    contract_id,\n    lead_id,\n    canais,\n    conteudo,\n    supabase_url: supabaseUrl.replace(/\\/$/, ''),\n    service_role: serviceRole,\n    output_folder_id: $vars.CONTRACT_OUTPUT_FOLDER_ID ?? 'root'\n  }\n}];"
      },
      "id": "08ef8501-4b26-4232-ae39-617aeb9217a1",
      "name": "Validar Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        320
      ]
    },
    {
      "parameters": {
        "url": "={{ $json.supabase_url + '/rest/v1/leads?id=eq.' + $json.lead_id + '&tenant_id=eq.' + $json.tenant_id + '&select=id,tenant_id,name,email,phone' }}",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "apikey",
              "value": "={{ $json.service_role }}"
            },
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $json.service_role }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {}
      },
      "id": "fc9ccbb8-1da0-4e91-8f05-d919fcfbf102",
      "name": "Buscar Lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        800,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const base = $('Validar Payload').item.json;\nconst leadRows = Array.isArray($json) ? $json : ($json.data ?? []);\nconst lead = Array.isArray(leadRows) ? (leadRows[0] ?? {}) : ($json ?? {});\n\nconst leadName = String(lead.name ?? '').trim();\nconst safeName = (leadName || base.contract_id).replace(/[\\\\/:*?\"<>|]+/g, '-').replace(/\\s+/g, ' ').trim();\nconst fileName = `Contrato - ${safeName}.pdf`;\nconst docName = fileName.replace(/\\.pdf$/i, '');\nconst pdfInstructions = 'Baixe o PDF, assine digitalmente pelo GOV.br e envie o PDF assinado de volta por aqui.';\nconst emailSubject = `Contrato para assinatura - ${leadName || base.contract_id}`;\n\nreturn [{\n  json: {\n    ...base,\n    lead,\n    lead_name: leadName,\n    whatsapp_to: lead.phone ?? '',\n    email_to: lead.email ?? '',\n    file_name: fileName,\n    google_doc_name: docName,\n    whatsapp_message: `${pdfInstructions}\\n\\nLink do PDF: {{PDF_LINK}}`,\n    email_subject: emailSubject,\n    email_message: `${pdfInstructions}\\n\\nLink do PDF: {{PDF_LINK}}`,\n    should_whatsapp: Boolean(base.canais?.whatsapp && lead.phone),\n    should_email: Boolean(base.canais?.email && lead.email)\n  }\n}];"
      },
      "id": "53481ee1-bb08-44e6-8d43-1f0fb6e2f8c3",
      "name": "Montar Dados de Envio",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1080,
        320
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\nreturn [{\n  json: {\n    ...data,\n    google_drive_content: data.conteudo\n  }\n}];"
      },
      "id": "5ca72ee6-d2f0-476f-8b0d-57a66ac21b05",
      "name": "Preparar Conteudo do Contrato",

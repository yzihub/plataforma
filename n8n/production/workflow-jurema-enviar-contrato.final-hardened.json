    {
      "parameters": {
        "jsCode": "const data = $('Preparar Conteudo do Contrato').item.json;\nconst created = $json;\nconst docId = created.id ?? created.fileId ?? created.webViewLink?.match(/\\/d\\/([^/]+)/)?.[1];\nif (!docId) throw new Error('Google Drive nao retornou o ID do documento criado');\nconst documentLink = `https://docs.google.com/document/d/${docId}/edit?usp=sharing`;\nconst pdfLink = `https://docs.google.com/document/d/${docId}/export?format=pdf`;\nreturn [{\n  json: {\n    ...data,\n    google_document_id: docId,\n    document_link: documentLink,\n    pdf_link: pdfLink,\n    whatsapp_message: data.whatsapp_message.replace('{{PDF_LINK}}', pdfLink),\n    email_message: data.email_message.replace('{{PDF_LINK}}', pdfLink)\n  }\n}];"
      },

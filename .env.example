# ─── Supabase (REQUIRED) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── App (REQUIRED for auth redirects: Google OAuth, magic link) ──────────────
# In production: https://app.juremabksimoveis.com.br
# In local dev:   https://app.juremabksimoveis.com.br
NEXT_PUBLIC_APP_URL=https://app.juremabksimoveis.com.br

# --- Optional R&D / shadow agents (not used by Ju WhatsApp hot-path) ---
# Ju production WhatsApp no longer depends on Agno/YZI OS orchestration.
NEXT_PUBLIC_YZI_API_URL=https://yzi-os.yzihub.com

# ─── Tenants públicos (REQUIRED para chamadas frontend dos agentes) ───────────
NEXT_PUBLIC_DEFAULT_TENANT_ID=b179ae75-3d56-4de8-8840-fc9c4d9ec21e
NEXT_PUBLIC_CAFE_PAM_TENANT_ID=b179ae75-3d56-4de8-8840-fc9c4d9ec21e
NEXT_PUBLIC_JUREMA_TENANT_ID=82cc7aa9-fc6e-4f37-8d8e-8a71c1691361
JU_BEHAVIORAL_QA_TENANT_ID=00000000-0000-4000-8000-000000000000
JU_BEHAVIORAL_QA_PHONE=5583999990002

# ─── DEV_BYPASS (DEV ONLY — never set true in production) ─────────────────────
# Pula auth Supabase para desenvolvimento local sem rede.
# proxy.ts e TenantContext já bloqueiam em NODE_ENV=production por segurança.
DEV_BYPASS=false
NEXT_PUBLIC_DEV_BYPASS=false

# ─── n8n (YZI FACTORY) ────────────────────────────────────────────────────────
FACTORY_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/factory-activate
N8N_API=https://your-n8n-instance.com/api

# --- Runtime Gateway (optional; audits, replay, shadow evaluation) ---
# Not required by Ju production WhatsApp hot-path. Base origin only.
# Do not include /api/runtime/ju/state.
YZI_RUNTIME_API_URL=https://your-next-runtime-domain.com
YZI_RUNTIME_INTERNAL_KEY=change-me-long-random-secret

# ─── Webhook imóveis (compartilhado com plugin WordPress YZIWS_WEBHOOK_SECRET) ─
WEBHOOK_IMOVEIS_SECRET=change-me

# ─── WordPress (REQUIRED para integração de imóveis) ──────────────────────────
WORDPRESS_SITE_URL=https://juremabksimoveis.com.br
WORDPRESS_USERNAME=your-wp-user
WORDPRESS_APP_PASSWORD=your-wp-app-password

# ─── Evolution API (WhatsApp) ─────────────────────────────────────────────────
SERVER_URL=https://your-evolution-instance.com
AUTHENTICATION_API_KEY=your-evolution-key

# Evolution Audio Converter (WhatsApp encrypted audio -> valid OGG for OpenAI)
EVOLUTION_AUDIO_CONVERTER_URL=http://evolution-audio-converter:4040
EVOLUTION_AUDIO_CONVERTER_API_KEY=your-audio-converter-key

# ─── Public site URL (opcional, usado em meta tags) ───────────────────────────
NEXT_PUBLIC_SITE_URL=https://juremabksimoveis.com.br

# --- Ju Cognitive Runtime controlled pilot ---
JUREMA_RUNTIME_MODE=shadow
JU_RUNTIME_MODE=behavioral_qa
JUREMA_RUNTIME_PORT=3333
YZI_COGNITIVE_DECISION_URL=https://runtime.yzihub.com/cognitive/decide
JUREMA_TOOL_WEBHOOK_SECRET=change-me-same-secret-in-runtime-n8n-evolution
RUNTIME_COGNITIVE_WEBHOOK_SECRET=
EVOLUTION_WEBHOOK_SECRET=
JUREMA_RUNTIME_LOCK_TTL_MS=45000
JUREMA_OPENAI_MODEL=gpt-4.1
JUREMA_CUTOVER_SHADOW_ONLY=true
JUREMA_CUTOVER_INTERNAL_ONLY=true
JUREMA_CUTOVER_PILOT_GROUP=false
JUREMA_CUTOVER_PERCENTAGE=0
JUREMA_CUTOVER_FORCE_N8N=false
JUREMA_CUTOVER_FORCE_KERNEL=false
JUREMA_CUTOVER_EMERGENCY_FALLBACK=false
JUREMA_CUTOVER_READINESS_LEVEL=0
JUREMA_CUTOVER_PILOT_TENANTS=
JUREMA_CUTOVER_PILOT_PHONES=
JUREMA_CUTOVER_PILOT_LEADS=
JUREMA_PILOT_STAGE=0
JUREMA_PILOT_ROLLOUT_FROZEN=false
JUREMA_PILOT_BLOCKED_TENANTS=
JUREMA_PILOT_BLOCKED_PHONES=
JUREMA_PILOT_BLOCKED_LEADS=
JUREMA_PILOT_MAX_ORCHESTRATION_MS=8000
JUREMA_PILOT_MAX_TOOL_MS=2500
JUREMA_PILOT_MAX_TOTAL_MS=10000

# --- Ju Cognitive Runtime operational freeze ---
JUREMA_SIMPLE_MODE=true
JUREMA_MAX_RECENT_MESSAGES=20
JUREMA_MAX_SUMMARY_CHARS=2400
JUREMA_MAX_RETRIEVAL_CHUNKS=6
JUREMA_MAX_DOCTRINE_RETRIEVAL=2
JUREMA_MAX_METADATA_CHARS=4000
JUREMA_MAX_CONTEXT_CHARS=24000
JUREMA_MAX_ORCHESTRATION_PASSES=2
JUREMA_OPENAI_INPUT_USD_PER_1M_TOKENS=2
JUREMA_OPENAI_OUTPUT_USD_PER_1M_TOKENS=8

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App — REQUIRED for auth redirects (magic link, Google OAuth)
# In production (Vercel): set to your production URL (e.g. https://plataforma-xxx.vercel.app)
# In local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# n8n (YZI FACTORY)
FACTORY_N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/factory-activate
